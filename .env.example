# RoomTrace — Camera-Free Room Awareness
# Backend: Google Firebase (Authentication & Cloud Firestore)

# Authentication Mode: "firebase" (production) or "local" (offline demo)
VITE_AUTH_PROVIDER=firebase

# Firebase Client Configuration (from Firebase Console > Project settings > General > Your apps)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="freeroom-d6710.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="freeroom-d6710"
VITE_FIREBASE_STORAGE_BUCKET="freeroom-d6710.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
VITE_FIREBASE_DATABASE_URL="https://freeroom-d6710-default-rtdb.asia-southeast1.firebasedatabase.app"


# Demo devices (built-in esp32-lab-01 key etc.) are OFF unless this is "true". Local testing only; NEVER on Render.
# ROOMTRACE_ALLOW_DEMO_DEVICES=true

# Server-Side Firebase Admin SDK (Optional: from Firebase Console > Project settings > Service accounts)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"freeroom-d6710",...}'
