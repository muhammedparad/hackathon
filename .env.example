# RoomTrace — Camera-Free Room Awareness
# Backend: Google Firebase (Authentication & Cloud Firestore). Authentication is Firebase only.

# Firebase Client Configuration (from Firebase Console > Project settings > General > Your apps)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="freeroom-d6710.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="freeroom-d6710"
VITE_FIREBASE_STORAGE_BUCKET="freeroom-d6710.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"


# Server-Side Firebase Admin SDK (REQUIRED on the server: device auth, storage and the live WebSocket all need it)
# From Firebase Console > Project settings > Service accounts > Generate new private key
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"freeroom-d6710",...}'
