rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validates that the authenticated user owns the specified room
    function isRoomOwner(roomId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.user_id == request.auth.uid
      );
    }

    // 1. Users collection: user can only view and update their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Rooms collection: user can only manage their own rooms
    // Updates cannot change user_id (transfer ownership)
    match /rooms/{roomId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // 3. Room zones (hazard, restricted, bed, sofa, custom polygons)
    // Enforces room ownership and prevents moving zone to another room
    match /room_zones/{zoneId} {
      allow read: if isAuthenticated() && (resource == null || isRoomOwner(resource.data.room_id));
      allow create: if isAuthenticated() && isRoomOwner(request.resource.data.room_id);
      allow update: if isAuthenticated() &&
        isRoomOwner(resource.data.room_id) &&
        request.resource.data.room_id == resource.data.room_id;
      allow delete: if isAuthenticated() && isRoomOwner(resource.data.room_id);
    }

    // 4. Room objects (furniture, fixtures, obstacles)
    // Enforces room ownership and prevents moving object to another room
    match /room_objects/{objectId} {
      allow read: if isAuthenticated() && (resource == null || isRoomOwner(resource.data.room_id));
      allow create: if isAuthenticated() && isRoomOwner(request.resource.data.room_id);
      allow update: if isAuthenticated() &&
        isRoomOwner(resource.data.room_id) &&
        request.resource.data.room_id == resource.data.room_id;
      allow delete: if isAuthenticated() && isRoomOwner(resource.data.room_id);
    }

    // 5. Devices collection: user can manage devices assigned to them
    // Updates cannot transfer user_id
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // 6. Device credentials collection: CRITICAL HARDWARE SECURITY BARRIER
    // Client browsers CAN NEVER read or write device secret hashes.
    // Only the trusted backend using Firebase Admin SDK can access this collection.
    match /device_credentials/{credId} {
      allow read, write: if false;
    }

    // 7. Sensors collection: configuration per device owned by the user
    // Updates cannot transfer user_id
    match /sensors/{sensorId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // 8. Occupancy events: detection, movement, zone entry/exit
    // - Browsers can only read events for rooms they own.
    // - Events are created ONLY by the backend (Admin SDK) from real device data. Browsers cannot create any.
    // - A room owner can ONLY acknowledge an event:
    //   * Only acknowledged, acknowledged_at, acknowledged_by may change.
    //   * acknowledged must be boolean (true).
    //   * acknowledged_by must match the authenticated caller UID (request.auth.uid).
    //   * acknowledged_at must be validated as a server timestamp (request.time).
    // - Browsers may delete ONLY leftover records flagged simulated (from old versions) to clean them up.
    match /occupancy_events/{eventId} {
      allow read: if isAuthenticated() && (resource == null || isRoomOwner(resource.data.room_id));
      allow create: if false;
      allow update: if isAuthenticated() &&
        isRoomOwner(resource.data.room_id) &&
        request.resource.data.room_id == resource.data.room_id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledged_at', 'acknowledged_by']) &&
        request.resource.data.acknowledged is bool &&
        request.resource.data.acknowledged == true &&
        request.resource.data.acknowledged_by == request.auth.uid &&
        request.resource.data.acknowledged_at == request.time;
      allow delete: if isAuthenticated() &&
        isRoomOwner(resource.data.room_id) &&
        resource.data.simulated == true;
    }

    // 9. Telemetry & Radar targets: real-time point-cloud and target telemetry
    // Read-only for authenticated room owners. Writes are strictly restricted to trusted ingestion backend.
    match /telemetry/{telemetryId} {
      allow read: if isAuthenticated() && (resource == null || isRoomOwner(resource.data.room_id));
      allow write: if false; // Only Firebase Admin SDK backend can write hardware telemetry
    }

    match /radar_targets/{targetId} {
      allow read: if isAuthenticated() && (resource == null || isRoomOwner(resource.data.room_id));
      allow write: if false; // Only Firebase Admin SDK backend can write hardware radar targets
    }

    // 10. Trajectory Segments: Historical movement trails for playback
    // - Requires authentication and room ownership to read.
    // - Written ONLY by the backend (Admin SDK) from real device data. Browsers cannot create or update.
    // - Browsers may delete ONLY leftover records flagged simulated (from old versions) to clean them up.
    match /trajectory_segments/{segId} {
      allow read: if isAuthenticated() && (resource == null || isRoomOwner(resource.data.room_id));
      allow create, update: if false;
      allow delete: if isAuthenticated() &&
        isRoomOwner(resource.data.room_id) &&
        resource.data.simulated == true;
    }
  }
}
